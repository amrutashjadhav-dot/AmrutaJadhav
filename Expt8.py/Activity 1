balance = 5000

try:
    amount = int(input("Enter withdrawal amount: "))
    if amount > balance:
        raise Exception("Insufficient balance!")
    balance -= amount
    print("Withdrawal successful. Remaining balance:", balance)

except Exception as e:
    print("Error:", e)
