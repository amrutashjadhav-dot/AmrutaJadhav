# Input product prices
n = int(input("Enter number of products: "))
prices = []

for i in range(n):
    price = float(input(f"Enter price of product {i+1}: "))
    prices.append(price)

# Calculate total bill
total = sum(prices)

print("Prices:", prices)
print("Total bill:", total)
